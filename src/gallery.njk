---
layout: layouts/base.njk
permalink: /gallery.html
extraStyles: ["projects.css", "gallery.css"]
---
{%- from "partials/macros.njk" import galleryCard %}
        {%- for block in gallery %}
        {%- if block.type == "prose" %}
        <section class="abstract">
            <div class="content">
                {%- if block.h2 %}<h2>{{ block.h2 }}</h2>{% endif %}
                {%- if block.h3 %}<h3>{{ block.h3 }}</h3>{% endif %}
                <p>{{ block.html | safe }}</p>
            </div>
        </section>
        {%- elif block.type == "gallery" %}
        <section class="projects">
            <div class="content">
                {%- for row in block.rows %}
                <div class="display_row">
                    {%- for item in row.items %}{{ galleryCard(item, row.variant) }}{%- endfor %}
                </div>
                {%- endfor %}
            </div>
        </section>
        {%- endif %}
        {%- endfor %}
